---
layout: base-new.njk
title: Dialog Lab
description: Be heard
demoOverlay: true
---

<section id="what" class="page-new__anchor page-new__anchor--what" aria-label="What">
  <div class="page-new__hero">
    <h1 class="page-new__hero-headline">
      Talk to someone with a different view, and <em>let your guard down</em>.
    </h1>

    <div
      class="page-new__hero-previews"
      x-data="{
        slides: [
          { image: '{{ '/assets/images/hero-mockup-topics.png' | url }}', caption: 'Pick a topic you care about' },
          { image: '{{ '/assets/images/hero-mockup-match.png' | url }}', caption: 'Match with someone who sees it differently' },
          { image: '{{ '/assets/images/hero-mockup-chat.png' | url }}', caption: 'Speak freely. An AI moderator defuses tension before it builds' },
        ],
        current: 0,
        dragging: false,
        dragStartX: 0,
        dragPointerId: null,
        goTo(index) {
          this.current = index;
        },
        next() {
          this.current = (this.current + 1) % this.slides.length;
        },
        prev() {
          this.current = (this.current - 1 + this.slides.length) % this.slides.length;
        },
        onDragStart(e) {
          if (window.matchMedia('(min-width: 768px)').matches) return;
          if (e.pointerType === 'mouse' && e.button !== 0) return;
          this.dragging = true;
          this.dragStartX = e.clientX;
          this.dragPointerId = e.pointerId;
          e.currentTarget.setPointerCapture(e.pointerId);
        },
        onDragEnd(e) {
          if (!this.dragging || e.pointerId !== this.dragPointerId) return;
          this.dragging = false;
          const delta = e.clientX - this.dragStartX;
          this.dragPointerId = null;
          try { e.currentTarget.releasePointerCapture(e.pointerId); } catch (_) {}
          if (Math.abs(delta) < 40) return;
          if (delta < 0) this.next();
          else this.prev();
        },
        onDragCancel(e) {
          if (e.pointerId !== this.dragPointerId) return;
          this.dragging = false;
          this.dragPointerId = null;
          try { e.currentTarget.releasePointerCapture(e.pointerId); } catch (_) {}
        }
      }"
    >
      <div
        class="page-new__hero-viewport"
        :class="{ 'is-dragging': dragging }"
        @pointerdown="onDragStart($event)"
        @pointerup="onDragEnd($event)"
        @pointercancel="onDragCancel($event)"
      >
        <div class="page-new__hero-track" :class="{ 'is-dragging': dragging }" :style="`--hero-index: ${current}`">
          <template x-for="(slide, index) in slides" :key="index">
            <figure class="page-new__hero-slide">
              <div class="page-new__hero-mockup">
                <img
                  :src="slide.image"
                  alt=""
                  width="327"
                  height="674"
                  decoding="async"
                  class="page-new__hero-mockup-img"
                />
              </div>
              <figcaption class="page-new__hero-caption">
                <span class="page-new__hero-caption-num" x-text="index + 1" aria-hidden="true"></span>
                <span class="page-new__hero-caption-text" x-text="slide.caption"></span>
              </figcaption>
            </figure>
          </template>
        </div>
      </div>

      <div class="page-new__hero-pagination" role="tablist" aria-label="App preview screens">
        <template x-for="(slide, index) in slides" :key="index">
          <button
            type="button"
            class="page-new__hero-dot"
            :class="{ 'is-active': current === index }"
            :aria-selected="current === index"
            :aria-label="`Screen ${index + 1}: ${slide.caption}`"
            role="tab"
            @click="goTo(index)"
          ></button>
        </template>
      </div>
    </div>

    <div class="page-new__hero-actions">
      <button type="button" class="page-new__demo-cta" data-demo-open data-track-demo="hero">
        Try the demo now
      </button>

      {% if site.appStoreLive %}
      <a
        href="{{ site.appStoreUrl or '#' }}"
        class="page-new__hero-store"
        data-track-appstore="hero"
        {% if site.appStoreUrl and site.appStoreUrl != '#' %}
        target="_blank"
        rel="noopener noreferrer"
        {% endif %}
      >
        <img
          class="page-new__hero-store-badge"
          src="{{ '/assets/images/Download_on_the_App_Store_Badge_US-UK_RGB_blk_092917.svg' | url }}"
          alt="Download on the App Store"
          width="200"
          height="67"
          decoding="async"
        />
      </a>
      {% else %}
      <span class="page-new__hero-store page-new__store--disabled" aria-disabled="true">
        <img
          class="page-new__hero-store-badge"
          src="{{ '/assets/images/Download_on_the_App_Store_Badge_US-UK_RGB_blk_092917.svg' | url }}"
          alt="Download on the App Store (coming soon)"
          width="200"
          height="67"
          decoding="async"
        />
      </span>
      {% endif %}
    </div>
  </div>
</section>

<section id="founder-note" class="page-new__anchor page-new__anchor--why" aria-label="Founder note">
  <div class="page-new__why">
    <div class="page-new__why-card">
      <div class="page-new__why-content">
        <h2 class="page-new__why-title">I went looking for someone on the other side</h2>

        <div class="page-new__why-prose">
          <p>
            In the wake of political violence, I wanted to find someone to have a heart-to-heart with, hoping we could get past the labels and see each other as fellow citizens who want what's best for the country.
          </p>
          <p>
            That conversation took me almost a year to find. Not because people wouldn't talk, but because we're all operating with our guard up, and it has made talking about politics really suck.
          </p>
          <p>
            I built Dialog Lab so no one has to go looking. It quickly matches you with someone on the other side, and the conversation that follows is one where you'll actually be heard.
          </p>
          <p class="page-new__why-signature">— Spencer Frank, founder</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="join" class="page-new__anchor page-new__anchor--join" aria-label="Sign up for updates">
  <div class="page-new__signup">
    <div class="page-new__signup-intro">
      <h2 class="page-new__signup-headline">
        Sign-up, and <em>think for yourself</em>
      </h2>
      <p class="page-new__signup-lede">
        Get updates about new features, and find out when we launch for other platforms!
      </p>
    </div>

    <div class="page-new__signup-form-wrap">
      <div class="page-new__signup-card">
        <form
          class="page-new__signup-form"
          x-data="{
            status: 'idle',
            errorMessage: '',
            trackInterest(platform, checked) {
              if (window.posthog && typeof window.posthog.capture === 'function') {
                window.posthog.capture('platform_interest_toggled', {
                  platform: platform,
                  interested: checked,
                });
              }
            },
            submit(event) {
              this.status = 'loading';
              this.errorMessage = '';
              const form = event.target;
              const data = new FormData(form);
              const email = (data.get('email') || '').toString().trim();
              const interestedAndroid = data.get('interest_android') === 'yes';
              const interestedWeb = data.get('interest_web') === 'yes';

              try {
                if (window.posthog && typeof window.posthog.capture === 'function') {
                  if (email && typeof window.posthog.identify === 'function') {
                    window.posthog.identify(email, {
                      email: email,
                      interested_android: interestedAndroid,
                      interested_web: interestedWeb,
                    });
                  }
                  window.posthog.capture('newsletter_signup', {
                    email: email,
                    interested_android: interestedAndroid,
                    interested_web: interestedWeb,
                  });
                }
                if (window.fbq) fbq('track', 'Lead');
                this.status = 'success';
                form.reset();
              } catch (e) {
                this.errorMessage = 'Something went wrong. Please try again.';
                this.status = 'error';
              }
            }
          }"
          @submit.prevent="submit($event)"
        >
          <template x-if="status === 'success'">
            <p class="page-new__signup-message page-new__signup-message--success">
              Thanks — you're on the list. We'll be in touch with updates.
            </p>
          </template>

          <template x-if="status !== 'success'">
            <div class="page-new__signup-fields page-new__signup-fields--newsletter">
              <div class="page-new__signup-field">
                <label class="page-new__signup-label" for="signup-email">Your Email</label>
                <input
                  id="signup-email"
                  class="page-new__signup-input"
                  type="email"
                  name="email"
                  maxlength="128"
                  required
                  autocomplete="email"
                />
              </div>

              <label class="page-new__signup-interest">
                <input
                  class="page-new__signup-interest-check"
                  type="checkbox"
                  name="interest_android"
                  value="yes"
                  @change="trackInterest('android', $event.target.checked)"
                />
                <span>I am interested in an Android version</span>
              </label>

              <label class="page-new__signup-interest">
                <input
                  class="page-new__signup-interest-check"
                  type="checkbox"
                  name="interest_web"
                  value="yes"
                  @change="trackInterest('web', $event.target.checked)"
                />
                <span>I am interested in a web version</span>
              </label>

              <template x-if="status === 'error'">
                <p class="page-new__signup-message page-new__signup-message--error" x-text="errorMessage"></p>
              </template>

              <div class="page-new__signup-submit-wrap">
                <button class="page-new__signup-submit" type="submit" :disabled="status === 'loading'">
                  <span x-show="status !== 'loading'">Get Updates</span>
                  <span x-show="status === 'loading'">Sending…</span>
                </button>
              </div>
            </div>
          </template>
        </form>
      </div>
    </div>
  </div>
</section>

