</footer>

<script>
  (function () {
    function isIOS() {
      var ua = navigator.userAgent || "";
      var platform = navigator.platform || "";
      var maxTouch = navigator.maxTouchPoints || 0;
      return /iPad|iPhone|iPod/.test(ua) || (platform === "MacIntel" && maxTouch > 1);
    }

    var deviceOs = isIOS() ? 'iOS' : 'other';

    document.addEventListener('click', function (e) {
      var appStoreEl = e.target.closest('[data-track-appstore]');
      if (appStoreEl && window.posthog) {
        posthog.capture('app_store_click', {
          location: appStoreEl.getAttribute('data-track-appstore'),
          device_os: deviceOs,
        });
      }

      var demoEl = e.target.closest('[data-track-demo]');
      if (demoEl && window.posthog) {
        posthog.capture('demo_open', {
          location: demoEl.getAttribute('data-track-demo'),
          device_os: deviceOs,
        });
      }
    });
  })();
</script>
